	// 	st,tamp-mode = <TAMPER_CONFIRMED_MODE>;
	// 	st,tamp-id = <2>;
	// 	status = "okay";
	// };

	// /* Connect pin8 and pin22 from CN8 */
	// tamp-active {
	// 	tamper-gpios = <&gpioc 0 0>, <&gpioi 0 0>;
	// 	st,tamp-mode = <TAMPER_CONFIRMED_MODE>;
	// 	st,tamp-id = <3>, <1>;
	// 	status = "disabled";
	// };
};

&timers12 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&tzc400 {
	memory-region = <&optee_framebuffer>;
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pins_a>;
	status = "okay";
};

&usart1 {
	pinctrl-names = "default";
	status = "disabled";
};
